<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>preview</LangVersion>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\AutoShopper\Core\Shared\**\*.cs" Link="Shared\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\AutoShopper\Core\Planning\**\*.cs" Link="Planning\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\AutoShopper\Core\Execution\Model\**\*.cs" Link="Execution\Model\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\AutoShopper\Core\Shopping\Model\**\*.cs" Link="Shopping\Model\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\AutoShopper\Core\Shopping\Import\**\*.cs" Link="Shopping\Import\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\AutoShopper\Core\Pricing\Model\**\*.cs" Link="Pricing\Model\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\AutoShopper\Core\Pricing\Universalis\**\*.cs" Link="Pricing\Universalis\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\AutoShopper\Core\Pricing\RequestThrottle.cs" Link="Pricing\RequestThrottle.cs" />
    <Compile Include="..\AutoShopper\Core\Pricing\UniversalisClient.cs" Link="Pricing\UniversalisClient.cs" />
    <Compile Include="..\AutoShopper\Core\Preview\Model\**\*.cs" Link="Preview\Model\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\AutoShopper\Core\Ledger\**\*.cs" Link="Ledger\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\AutoShopper\Core\Market\Model\**\*.cs" Link="Market\Model\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\AutoShopper\Core\Travel\StandSpot.cs" Link="Travel\StandSpot.cs" />
    <Compile Include="..\AutoShopper\ConfigEnums.cs" Link="ConfigEnums.cs" />
    <Compile Include="..\AutoShopper\Core\Exports\**\*.cs" Link="Exports\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\AutoShopper\Core\Recipes\**\*.cs" Exclude="..\AutoShopper\Core\Recipes\RecipeExpander.cs" Link="Recipes\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\AutoShopper\Core\Api\Model\**\*.cs" Link="Api\Model\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\AutoShopper\Core\Stats\RunOutcome.cs" Link="Stats\RunOutcome.cs" />
    <Compile Include="..\AutoShopper\Core\Stats\ReturnHomeResult.cs" Link="Stats\ReturnHomeResult.cs" />
    <Compile Include="..\AutoShopper\Core\Tasks\RunProgress.cs" Link="Tasks\RunProgress.cs" />
    <Compile Include="..\AutoShopper\Core\Tasks\PauseReason.cs" Link="Tasks\PauseReason.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="ImportFixtures\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Fixtures\**\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="System" />
    <Using Include="System.Collections" />
    <Using Include="System.Collections.Generic" />
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
